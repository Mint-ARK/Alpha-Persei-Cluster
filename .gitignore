# ==============================================================================
# Alpha-Persei-Cluster - Git Ignore Configuration
# ==============================================================================

# Security, Credentials & Local Environments
*.pem
*.key
*.p12
*.pfx
*.env
.env
.env.*
!.env.example
*.pid
.secret_vault.json

# Database Files & SQLite State Wal
*.db
*.db-*
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak
*.bak_*
account.db
backup/
db_backup/

# Traffic Dumps & Execution Logs
*.pcap
*.pcapng
*.log
logs/
**/logs/

# Python Runtimes & Bytecode Cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
venv/
.venv/

# WinUI 3 / .NET Build Artifacts & User State
**/bin/
**/obj/
**/.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Frontend Dependencies & Staging Bundles
node_modules/
**/node_modules/
.vite/
dist/

# OS Specific & Editor Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local work records and partial downloads are not release sources.
/AGENT_BOARD.md
/.agent-memory.md
/agent-memory.md
/archive/
*.before*
*.part

# Per-host runtime state
/v5_server/data/slot_registry.json
/v5_server/.save-generation.lock
linux_config.json
linux_generated/

# Host download state
/v5_server/runtime/
/v5_server/cdn_cache/
*.json.lock

# Host-local admin password hash
linux_admin_auth.json
v5_server/data/launch_overrides.json
