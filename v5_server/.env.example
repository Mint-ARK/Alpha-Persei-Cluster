# ==============================================================================
# AetherGazer V5 - 环境变量配置文件模板 (Environment Template)
# ==============================================================================
# 使用说明：
# 1. 复制本文件为 .env 即可生效
# 2. 在下方填入您自己的各大模型供应商 API 密钥（可选）
# 3. 严禁将包含真实 API 密钥的 .env 文件提交到代码仓库或打包发布！
# ==============================================================================

# OpenCode / Zen 服务密钥 (https://opencode.ai)
OPENCODE_GO_API_KEY=

# Google Gemini API 密钥 (https://aistudio.google.com)
GEMINI_API_KEY=

# DeepSeek 官方 API 密钥 (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# OpenAI 官方 API 密钥 (可选)
OPENAI_API_KEY=

# Anthropic Claude API 密钥 (可选)
ANTHROPIC_API_KEY=
